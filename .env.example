# MECUT Radar environment variables
#
# Copy this file to .env for local development:
#
# Windows PowerShell:
#   Copy-Item .env.example .env
#
# Linux/macOS:
#   cp .env.example .env
#
# Never commit the real .env file.

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub API
#
# Optional for local development when using only public data.
# Recommended for scheduled/API-heavy usage because authenticated
# requests have higher rate limits than unauthenticated requests.
GITHUB_TOKEN=
